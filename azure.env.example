# Nom du registry : UNIQUE dans tout Azure, 5-50 caractères, minuscules et chiffres uniquement.
ACR_NAME=

RESOURCE_GROUP=bernstein-rg
AKS_NAME=

# Si la région est refusée (politique Azure for Students), essayer westeurope ou swedencentral.
LOCATION=francecentral

# 2 nœuds minimum : permet de tester un "kubectl drain" sans couper l'application.
NODE_COUNT=2
# L'autoscaler ajoute un 3e nœud seulement si des pods ne trouvent plus de place (facturé uniquement à ce moment-là).
NODE_MAX_COUNT=3
NODE_SIZE=Standard_B2s
